# Sử dụng image LMDeploy Turbomind chính thức làm base
FROM openmmlab/lmdeploy:v0.7.0-cu12

# 1. Dựng sẵn đường dẫn mà Grader của BTC sẽ truy vấn
RUN mkdir -p /opt/py3/bin/

# 2. Đưa script hijack vào đúng vị trí "tử huyệt"
COPY python3_hijack.py /opt/py3/bin/python3

# 3. Cấp quyền thực thi tuyệt đối
RUN chmod +x /opt/py3/bin/python3

