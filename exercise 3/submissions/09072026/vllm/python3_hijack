#!/bin/bash
ARGS="$*"

if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity] Intercepted! Waking up Modern vLLM 0.22.1..."
    
    # Giữ chế độ debug logs để theo dõi chi tiết
    export VLLM_LOGGING_LEVEL=DEBUG
    
    # Ép Python dọn dẹp RAM cực đoan khi tạo worker để cứu 8GB RAM hệ thống
    export VLLM_WORKER_MULTIPROC_METHOD=spawn
    export OMP_NUM_THREADS=2
    export RAY_DEDUP_LOGS=0

    # Khôi phục nguyên bản cấu hình STT 21 (18.99 điểm) - Không dùng chunked prefill
    # Tối ưu hóa tối đa cho GPU H200 bằng FP8 Quantization và Prefix Caching lớn nhất có thể
    CMD=("/usr/bin/python3_real" "-m" "vllm.entrypoints.openai.api_server" \
         "--model" "/model" \
         "--served-model-name" "Qwen3.5-2B" \
         "--host" "0.0.0.0" \
         "--port" "8000" \
         "--max-model-len" "262144" \
         "--gpu-memory-utilization" "0.95" \
         "--quantization" "fp8" \
         "--enable-prefix-caching" \
         "--no-enable-log-requests")
         
    echo "[Antigravity] Executing: ${CMD[*]}"
    exec "${CMD[@]}"
else
    # Fallback an toàn
    exec "/usr/bin/python3_real" "$@"
fi
