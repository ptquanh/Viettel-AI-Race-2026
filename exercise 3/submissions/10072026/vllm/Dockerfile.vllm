# Sử dụng base image vLLM v0.22.1 chính thức có hỗ trợ Qwen3.5
FROM vllm/vllm-openai:v0.22.1

# 1. Đổi tên Python gốc để tránh đệ quy và nhường chỗ cho kịch bản
RUN mv /usr/bin/python3 /usr/bin/python3_real

# 2. Đặt kịch bản đánh chặn vào đúng vị trí Python cũ
COPY python3_hijack /usr/bin/python3
RUN sed -i 's/\r$//' /usr/bin/python3 && chmod +x /usr/bin/python3
