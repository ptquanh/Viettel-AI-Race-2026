#!/bin/bash
ARGS="$*"

if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity] Intercepted! Waking up Modern vLLM 0.22.1 + FP8 KV Cache..."
    
    # Giảm logging overhead
    export VLLM_LOGGING_LEVEL=WARNING
    
    # Worker config
    export VLLM_WORKER_MULTIPROC_METHOD=spawn
    export RAY_DEDUP_LOGS=0

    # Cấu hình STT 21 gốc (18.99 điểm) + FP8 KV Cache
    # Combo: FP8 model weights + FP8 KV cache
    # Kỳ vọng: Halve KV cache bandwidth → TPOT giảm từ 51ms → ~27-30ms
    CMD=("/usr/bin/python3_real" "-m" "vllm.entrypoints.openai.api_server" \
         "--model" "/model" \
         "--served-model-name" "Qwen3.5-2B" \
         "--host" "0.0.0.0" \
         "--port" "8000" \
         "--max-model-len" "262144" \
         "--gpu-memory-utilization" "0.95" \
         "--quantization" "fp8" \
         "--kv-cache-dtype" "fp8" \
         "--enable-prefix-caching" \
         "--no-enable-log-requests")
         
    echo "[Antigravity] Executing: ${CMD[*]}"
    exec "${CMD[@]}"
else
    # Fallback an toàn
    exec "/usr/bin/python3_real" "$@"
fi
