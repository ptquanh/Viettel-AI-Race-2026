#!/bin/bash
ARGS="$*"

if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity v4] Intercepted! Ghost Strategy v4 — INT4 KV Cache Edition"
    
    # Giảm tối đa logging overhead
    export VLLM_LOGGING_LEVEL=WARNING
    export VLLM_WORKER_MULTIPROC_METHOD=spawn
    export OMP_NUM_THREADS=2
    export RAY_DEDUP_LOGS=0

    # Đọc cấu hình động từ Environment Variables
    MAX_NUM_SEQS=${VLLM_MAX_NUM_SEQS:-86}
    MAX_NUM_BATCHED_TOKENS=${VLLM_MAX_NUM_BATCHED_TOKENS:-4096}
    ENABLE_CHUNKED_PREFILL=${VLLM_ENABLE_CHUNKED_PREFILL:-0}
    KV_CACHE_DTYPE=${VLLM_KV_CACHE_DTYPE:-auto}
    QUANTIZATION=${VLLM_QUANTIZATION:-fp8}
    
    echo "[Antigravity v4] Config:"
    echo "  Seqs: ${MAX_NUM_SEQS}"
    echo "  Chunked Prefill: ${ENABLE_CHUNKED_PREFILL}"
    echo "  Batched Tokens: ${MAX_NUM_BATCHED_TOKENS}"
    echo "  KV Cache Dtype: ${KV_CACHE_DTYPE}"
    echo "  Quantization: ${QUANTIZATION}"

    CMD=("/usr/bin/python3_real" "-m" "vllm.entrypoints.openai.api_server" \
         "--model" "/model" \
         "--served-model-name" "Qwen3.5-2B" \
         "--host" "0.0.0.0" \
         "--port" "8000" \
         "--max-model-len" "262144" \
         "--gpu-memory-utilization" "0.95" \
         "--enable-prefix-caching" \
         "--max-num-seqs" "$MAX_NUM_SEQS" \
         "--no-enable-log-requests")

    # KV Cache quantization
    if [ "$KV_CACHE_DTYPE" != "auto" ]; then
        CMD+=("--kv-cache-dtype" "$KV_CACHE_DTYPE")
    fi

    # Weight quantization
    if [ "$QUANTIZATION" != "none" ]; then
        CMD+=("--quantization" "$QUANTIZATION")
    fi

    # Chunked prefill
    if [ "$ENABLE_CHUNKED_PREFILL" = "1" ]; then
        CMD+=("--enable-chunked-prefill" "--max-num-batched-tokens" "$MAX_NUM_BATCHED_TOKENS")
    fi
         
    echo "[Antigravity v4] Executing: ${CMD[*]}"
    exec "${CMD[@]}"
else
    # Fallback an toàn
    exec "/usr/bin/python3_real" "$@"
fi
