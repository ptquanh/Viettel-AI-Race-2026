#!/bin/bash
ARGS="$*"
if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity Phase 2] Custom Kernel Injector + Warmup Edition"
    
    # Export PYTHONPATH so sitecustomize.py gets loaded
    export PYTHONPATH="/patch:$PYTHONPATH"
    export VLLM_LOGGING_LEVEL=WARNING
    export OMP_NUM_THREADS=3

    # Ensure max-num-seqs is handled 
    MAX_NUM_SEQS=${VLLM_MAX_NUM_SEQS:-256}
    QUANTIZATION=${VLLM_QUANTIZATION:-fp8}
    KV_CACHE_DTYPE=${VLLM_KV_CACHE_DTYPE:-fp8}
    WARMUP_ENABLED=${VLLM_WARMUP:-1}
    
    CMD=("/usr/bin/python3_real" "-m" "vllm.entrypoints.openai.api_server"
         "--model" "/model"
         "--served-model-name" "Qwen3.5-2B"
         "--host" "0.0.0.0" "--port" "8000"
         "--max-model-len" "262144"
         "--gpu-memory-utilization" "0.95"
         "--enable-prefix-caching"
         "--max-num-seqs" "$MAX_NUM_SEQS"
         "--enable-chunked-prefill"
         "--max-num-batched-tokens" "4096"
         "--no-enable-log-requests"
         "--kv-cache-dtype" "$KV_CACHE_DTYPE")

    if [ "$QUANTIZATION" != "none" ]; then
        CMD+=("--quantization" "$QUANTIZATION")
    fi

    # Start the server in the background
    "${CMD[@]}" &
    SERVER_PID=$!

    if [ "$WARMUP_ENABLED" = "1" ]; then
        echo "[Antigravity Phase 2] Waiting for server to start warmup..."
        
        # Poll until server is healthy (max 120s)
        for i in $(seq 1 120); do
            if curl -s http://localhost:8000/health > /dev/null 2>&1; then
                echo "[Antigravity Phase 2] Server ready! Starting compilation warmup..."
                break
            fi
            sleep 1
        done
        
        # Send a dummy request to trigger Triton JIT compilation of FP8 KV attention kernels
        curl -s http://localhost:8000/v1/chat/completions \
            -H "Content-Type: application/json" \
            -d '{"model": "Qwen3.5-2B", "messages": [{"role": "user", "content": "hello"}], "max_tokens": 1, "temperature": 0}' > /dev/null 2>&1
            
        echo "[Antigravity Phase 2] Warmup request sent. Triton kernels compiled!"
    fi

    # Wait for the server process to finish
    wait $SERVER_PID
else
    exec "/usr/bin/python3_real" "$@"
fi
