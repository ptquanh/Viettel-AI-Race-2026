#!/bin/bash
ARGS="$*"
if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity Phase 2 v3] Custom Kernel Injector + Offline Draft Model Speculative Edition for LFM2.5"
    
    # Export PYTHONPATH so sitecustomize.py gets loaded
    export PYTHONPATH="/patch:$PYTHONPATH"
    export VLLM_LOGGING_LEVEL=WARNING
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-2}

    # Đọc cấu hình động từ env vars
    MAX_MODEL_LEN=${VLLM_MAX_MODEL_LEN:-32768}
    MAX_NUM_SEQS=${VLLM_MAX_NUM_SEQS:-32}
    GPU_MEMORY_UTILIZATION=${VLLM_GPU_MEMORY_UTILIZATION:-0.95}
    TENSOR_PARALLEL_SIZE=${VLLM_TENSOR_PARALLEL_SIZE:-1}
    QUANTIZATION=${VLLM_QUANTIZATION:-fp8}
    KV_CACHE_DTYPE=${VLLM_KV_CACHE_DTYPE:-auto}
    WARMUP_ENABLED=${VLLM_WARMUP:-1}
    MAX_NUM_BATCHED_TOKENS=${VLLM_MAX_NUM_BATCHED_TOKENS:-4096}
    ENABLE_CHUNKED_PREFILL=${VLLM_ENABLE_CHUNKED_PREFILL:-0}
    COMPILATION_LEVEL=${VLLM_COMPILATION_LEVEL:-3}

    # Cấu hình Speculative Decoding
    SPECULATIVE_MODEL=${VLLM_SPECULATIVE_MODEL:-}
    NUM_SPECULATIVE_TOKENS=${VLLM_NUM_SPECULATIVE_TOKENS:-5}
    
    CMD=("/usr/bin/python3_real" "-m" "vllm.entrypoints.openai.api_server"
         "--model" "/model"
         "--served-model-name" "LFM2.5-1.2B-Instruct"
         "--host" "0.0.0.0" "--port" "8000"
         "--max-model-len" "$MAX_MODEL_LEN"
         "--gpu-memory-utilization" "$GPU_MEMORY_UTILIZATION"
         "--tensor-parallel-size" "$TENSOR_PARALLEL_SIZE"
         "--enable-prefix-caching"
         "--max-num-seqs" "$MAX_NUM_SEQS"
         "--no-enable-log-requests"
         "--disable-log-stats")

    if [ "$COMPILATION_LEVEL" != "0" ]; then
        CMD+=("--compilation-config" "{\"mode\": $COMPILATION_LEVEL}")
    fi

    if [ "$KV_CACHE_DTYPE" != "auto" ]; then
        CMD+=("--kv-cache-dtype" "$KV_CACHE_DTYPE")
    fi

    if [ "$QUANTIZATION" != "none" ]; then
        CMD+=("--quantization" "$QUANTIZATION")
    fi

    if [ -n "$SPECULATIVE_MODEL" ]; then
        if [ "$SPECULATIVE_MODEL" = "ngram" ] || [ "$SPECULATIVE_MODEL" = "[ngram]" ]; then
            CMD+=("--spec-method" "ngram")
            CMD+=("--spec-tokens" "$NUM_SPECULATIVE_TOKENS")
        elif [ "$SPECULATIVE_MODEL" = "draft" ] || [ "$SPECULATIVE_MODEL" = "auto" ] || [ "$SPECULATIVE_MODEL" = "1" ] || [ "$SPECULATIVE_MODEL" = "350M" ]; then
            CMD+=("--spec-method" "draft_model")
            CMD+=("--spec-model" "/draft_model")
            CMD+=("--spec-tokens" "$NUM_SPECULATIVE_TOKENS")
        else
            CMD+=("--spec-method" "draft_model")
            CMD+=("--spec-model" "$SPECULATIVE_MODEL")
            CMD+=("--spec-tokens" "$NUM_SPECULATIVE_TOKENS")
        fi
    fi

    if [ "$ENABLE_CHUNKED_PREFILL" = "1" ]; then
        CMD+=("--enable-chunked-prefill" "--max-num-batched-tokens" "$MAX_NUM_BATCHED_TOKENS")
    fi

    echo "[Antigravity Phase 2 v3] Executing: ${CMD[*]}"

    # Chạy server ở chế độ background để thực hiện warmup
    "${CMD[@]}" &
    SERVER_PID=$!

    if [ "$WARMUP_ENABLED" = "1" ]; then
        echo "[Antigravity Phase 2 v3] Waiting for server to start warmup..."
        
        # Poll healthcheck tối đa 120s
        for i in $(seq 1 120); do
            if curl -s http://localhost:8000/health > /dev/null 2>&1; then
                echo "[Antigravity Phase 2 v3] Server ready! Starting compilation warmup..."
                break
            fi
            sleep 1
        done
        
        # Gửi dummy request để kích hoạt JIT compilation của custom kernels và cache
        curl -s http://localhost:8000/v1/chat/completions \
            -H "Content-Type: application/json" \
            -d '{"model": "LFM2.5-1.2B-Instruct", "messages": [{"role": "user", "content": "hello"}], "max_tokens": 1, "temperature": 0}' > /dev/null 2>&1
            
        echo "[Antigravity Phase 2 v3] Warmup request sent successfully!"
    fi

    # Đợi tiến trình server chạy chính
    wait $SERVER_PID
else
    exec "/usr/bin/python3_real" "$@"
fi
