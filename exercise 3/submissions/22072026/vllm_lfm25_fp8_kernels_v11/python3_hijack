#!/bin/bash
ARGS="$*"
if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity Phase 2 v11.3] Modern vLLM Engine + Native Warmup + Perfect Pydantic SpeculativeConfig Edition"
    
    export PYTHONPATH="/patch:$PYTHONPATH"
    export VLLM_LOGGING_LEVEL=WARNING
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

    # Cấu hình cốt lõi
    MAX_MODEL_LEN=${VLLM_MAX_MODEL_LEN:-32768}
    MAX_NUM_SEQS=${VLLM_MAX_NUM_SEQS:-32}
    GPU_MEMORY_UTILIZATION=${VLLM_GPU_MEMORY_UTILIZATION:-0.95}
    TENSOR_PARALLEL_SIZE=${VLLM_TENSOR_PARALLEL_SIZE:-1}
    QUANTIZATION=${VLLM_QUANTIZATION:-fp8}
    COMPILATION_LEVEL=${VLLM_COMPILATION_LEVEL:-3}
    
    # Attention Backend
    ATTENTION_BACKEND=${VLLM_ATTENTION_BACKEND:-FLASHINFER}
    export VLLM_ATTENTION_BACKEND=$ATTENTION_BACKEND
    
    CMD=("/usr/bin/python3_real" "-m" "vllm.entrypoints.openai.api_server"
         "--model" "/model"
         "--served-model-name" "LFM2.5-1.2B-Instruct"
         "--host" "0.0.0.0" "--port" "8000"
         "--max-model-len" "$MAX_MODEL_LEN"
         "--gpu-memory-utilization" "$GPU_MEMORY_UTILIZATION"
         "--tensor-parallel-size" "$TENSOR_PARALLEL_SIZE"
         "--enable-prefix-caching"
         "--max-num-seqs" "$MAX_NUM_SEQS"
         "--no-enable-log-requests"
         "--disable-log-stats")

    # Speculative Decoding / Prompt Lookup Config via --spec-method & --speculative-config JSON
    SPECULATIVE_MODEL=${VLLM_SPECULATIVE_MODEL:-}
    NUM_SPECULATIVE_TOKENS=${VLLM_NUM_SPECULATIVE_TOKENS:-3}
    NGRAM_LOOKUP_MAX=${VLLM_NGRAM_PROMPT_LOOKUP_MAX:-4}
    NGRAM_LOOKUP_MIN=${VLLM_NGRAM_PROMPT_LOOKUP_MIN:-1}

    if [ "$SPECULATIVE_MODEL" == "[ngram]" ] || [ "$SPECULATIVE_MODEL" == "ngram" ] || [ -n "$SPECULATIVE_MODEL" ]; then
        CMD+=("--spec-method" "ngram")
        
        # Pydantic Dataclass SpeculativeConfig exact keyword arguments
        SPEC_JSON="{\"num_speculative_tokens\": $NUM_SPECULATIVE_TOKENS, \"prompt_lookup_max\": $NGRAM_LOOKUP_MAX, \"prompt_lookup_min\": $NGRAM_LOOKUP_MIN}"
        CMD+=("--speculative-config" "$SPEC_JSON")
    fi

    COMPILATION_LEVEL=${VLLM_COMPILATION_LEVEL:-3}
    CG_MODE=${VLLM_CUDAGRAPH_MODE:-FULL}
    CG_SIZES=${VLLM_CUDAGRAPH_CAPTURE_SIZES:-}
    CG_WARMUPS=${VLLM_CUDAGRAPH_NUM_OF_WARMUPS:-3}
    CG_MAX_SIZE=${VLLM_MAX_CUDAGRAPH_CAPTURE_SIZE:-}

    if [ "$COMPILATION_LEVEL" != "0" ]; then
        JSON_CFG="{\"mode\": $COMPILATION_LEVEL"
        if [ -n "$CG_MODE" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_mode\": \"$CG_MODE\""
        fi
        if [ -n "$CG_SIZES" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_capture_sizes\": $CG_SIZES"
        fi
        if [ -n "$CG_WARMUPS" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_num_of_warmups\": $CG_WARMUPS"
        fi
        if [ -n "$CG_MAX_SIZE" ]; then
            JSON_CFG="$JSON_CFG, \"max_cudagraph_capture_size\": $CG_MAX_SIZE"
        fi
        JSON_CFG="$JSON_CFG}"
        CMD+=("--compilation-config" "$JSON_CFG")
    fi

    if [ "$QUANTIZATION" != "none" ]; then
        CMD+=("--quantization" "$QUANTIZATION")
    fi

    BLOCK_SIZE=${VLLM_BLOCK_SIZE:-32}
    if [ "$BLOCK_SIZE" != "16" ]; then
        CMD+=("--block-size" "$BLOCK_SIZE")
    fi

    echo "[Antigravity Phase 2 v11.3] Executing Server: ${CMD[*]}"
    exec "${CMD[@]}"
else
    exec "/usr/bin/python3_real" "$@"
fi
