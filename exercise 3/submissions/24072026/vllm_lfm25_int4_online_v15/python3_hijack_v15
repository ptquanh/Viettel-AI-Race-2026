#!/bin/bash
ARGS="$*"
if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity Phase 3 v15.0] Heavy Weaponry - Online INT4 Quantization (torchao)"
    
    export PYTHONPATH="/patch:$PYTHONPATH"
    export VLLM_LOGGING_LEVEL=${VLLM_LOGGING_LEVEL:-WARNING}
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

    # Core
    MAX_MODEL_LEN=${VLLM_MAX_MODEL_LEN:-8192}
    MAX_NUM_SEQS=${VLLM_MAX_NUM_SEQS:-32}
    GPU_MEMORY_UTILIZATION=${VLLM_GPU_MEMORY_UTILIZATION:-0.95}
    TENSOR_PARALLEL_SIZE=${VLLM_TENSOR_PARALLEL_SIZE:-1}
    QUANTIZATION=${VLLM_QUANTIZATION:-fp8}
    
    # Attention
    ATTENTION_BACKEND=${VLLM_ATTENTION_BACKEND:-FLASHINFER}
    export VLLM_ATTENTION_BACKEND=$ATTENTION_BACKEND
    
    # Check if we should enable torchao INT4
    ENABLE_TORCHAO_INT4=${VLLM_ENABLE_TORCHAO_INT4:-0}

    # Write a wrapper python script to inject torchao quantization before starting vLLM
    cat << 'EOF' > /tmp/run_vllm_with_torchao.py
import sys
import os

# Intercept vLLM's model loading
if os.environ.get("VLLM_ENABLE_TORCHAO_INT4") == "1":
    print("[Antigravity] Injecting torchao online INT4 quantization hook...")
    import vllm.model_executor.model_loader as model_loader
    original_get_model = model_loader.get_model

    def get_model_with_quantization(*args, **kwargs):
        print("[Antigravity] Original model loading started...")
        model = original_get_model(*args, **kwargs)
        print("[Antigravity] Model loaded. Applying torchao int4_weight_only quantization...")
        
        try:
            import torchao
            from torchao.quantization import int4_weight_only
            
            # Apply to linear layers. Group size 128 is a good balance for LFM 1.2B
            group_size = int(os.environ.get("TORCHAO_GROUP_SIZE", "128"))
            torchao.quantize_(model, int4_weight_only(group_size=group_size))
            print(f"[Antigravity] Successfully quantized model to INT4 online (group_size={group_size}).")
        except Exception as e:
            print(f"[Antigravity] Error during online quantization: {e}")
            
        return model

    model_loader.get_model = get_model_with_quantization

# Start vLLM api server
from vllm.entrypoints.openai.api_server import main
if __name__ == "__main__":
    main()
EOF

    CMD=("/usr/bin/python3_real" "/tmp/run_vllm_with_torchao.py"
         "--model" "/model"
         "--served-model-name" "LFM2.5-1.2B-Instruct"
         "--host" "0.0.0.0" "--port" "8000"
         "--max-model-len" "$MAX_MODEL_LEN"
         "--gpu-memory-utilization" "$GPU_MEMORY_UTILIZATION"
         "--tensor-parallel-size" "$TENSOR_PARALLEL_SIZE"
         "--enable-prefix-caching"
         "--max-num-seqs" "$MAX_NUM_SEQS"
         "--no-enable-log-requests"
         "--disable-log-stats")

    # CUDA Graph
    COMPILATION_LEVEL=${VLLM_COMPILATION_LEVEL:-3}
    CG_MODE=${VLLM_CUDAGRAPH_MODE:-}
    CG_SIZES=${VLLM_CUDAGRAPH_CAPTURE_SIZES:-}
    CG_WARMUPS=${VLLM_CUDAGRAPH_NUM_OF_WARMUPS:-5}
    
    if [ "$COMPILATION_LEVEL" != "0" ] && [ -n "$CG_MODE" ]; then
        JSON_CFG="{\"mode\": $COMPILATION_LEVEL"
        JSON_CFG="$JSON_CFG, \"cudagraph_mode\": \"$CG_MODE\""
        if [ -n "$CG_SIZES" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_capture_sizes\": $CG_SIZES"
        fi
        if [ -n "$CG_WARMUPS" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_num_of_warmups\": $CG_WARMUPS"
        fi
        JSON_CFG="$JSON_CFG}"
        CMD+=("--compilation-config" "$JSON_CFG")
    fi

    if [ "$QUANTIZATION" != "none" ]; then
        CMD+=("--quantization" "$QUANTIZATION")
    fi

    BLOCK_SIZE=${VLLM_BLOCK_SIZE:-32}
    if [ "$BLOCK_SIZE" != "16" ]; then
        CMD+=("--block-size" "$BLOCK_SIZE")
    fi

    echo "[Antigravity Phase 3 v15.0] Executing Server: ${CMD[*]}"
    exec "${CMD[@]}"
else
    exec "/usr/bin/python3_real" "$@"
fi
