#!/bin/bash
ARGS="$*"
if [[ "$ARGS" == *"vllm.entrypoints.openai.api_server"* ]]; then
    echo "[Antigravity Phase 6 v23.2] FP8 + Tokenizer Patch + Chunked Prefill & Async Scheduling"
    
    export PYTHONPATH="/patch:$PYTHONPATH"
    export VLLM_LOGGING_LEVEL=WARNING
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
    
    # Start with original arguments from docker-compose
    CMD=("/usr/bin/python3_real" "$@")
    
    # Inject Golden Combo from teammate
    CMD+=("--enable-chunked-prefill")
    CMD+=("--max-num-batched-tokens" "1024")
    CMD+=("--async-scheduling")
    CMD+=("--performance-mode" "interactivity")
    CMD+=("--prefix-caching-hash-algo" "xxhash")
    CMD+=("--enable-prefix-caching")
    CMD+=("--no-enable-log-requests")
    CMD+=("--disable-log-stats")
    
    # CUDA Graph Compilation Config
    COMPILATION_LEVEL=${VLLM_COMPILATION_LEVEL:-3}
    CG_MODE=${VLLM_CUDAGRAPH_MODE:-}
    CG_SIZES=${VLLM_CUDAGRAPH_CAPTURE_SIZES:-}
    CG_WARMUPS=${VLLM_CUDAGRAPH_NUM_OF_WARMUPS:-3}
    
    if [ "$COMPILATION_LEVEL" != "0" ] && [ -n "$CG_MODE" ]; then
        JSON_CFG="{\"mode\": $COMPILATION_LEVEL"
        JSON_CFG="$JSON_CFG, \"cudagraph_mode\": \"$CG_MODE\""
        if [ -n "$CG_SIZES" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_capture_sizes\": $CG_SIZES"
        fi
        if [ -n "$CG_WARMUPS" ]; then
            JSON_CFG="$JSON_CFG, \"cudagraph_num_of_warmups\": $CG_WARMUPS"
        fi
        JSON_CFG="$JSON_CFG}"
        CMD+=("--compilation-config" "$JSON_CFG")
    fi

    echo "[Antigravity Phase 6 v23.2] Executing Server: ${CMD[*]}"
    exec "${CMD[@]}"
else
    exec "/usr/bin/python3_real" "$@"
fi
