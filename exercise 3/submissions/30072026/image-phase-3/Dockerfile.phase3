# Phase 3: Decode-Priority Scheduler Patch
# Base: v0.26.0 engine (sha256:dc9e) with FA3 + DeepGEMM + combo kernels
# Patch: Scheduler decode-priority to reduce TPOT
FROM docker.io/taze05/lfm25-h200-ers@sha256:dc9e6d3cbb0233756a3ecfaf3a913a52498d116ca1d2acaa1b4bac1da6fa3d2c

# Copy and apply scheduler patch
COPY phase3_patch.py /tmp/phase3_patch.py
RUN python3 /tmp/phase3_patch.py && rm /tmp/phase3_patch.py
